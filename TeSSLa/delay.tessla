-- ===========================================================================
-- delay.tessla
--  Delay rules. Terms as used in the course:
--    "Non-Blocking Delay" = Scheduler_vNonBlockedDelay: task goes BLOCKED,
--                           the CPU is freed  (events: delay_task/delay_ticks)
--    "Blocking Delay"     = Scheduler_vBlockedDelay: busy-wait, NO state
--                           change  (events: busy_task/busy_end)
--
--  java -jar tessla.jar interpreter tessla/delay.tessla trace.input
--  Passed = all violation_* streams stay empty.
--
--  See tessla/README.md for which trace to use, expected results, and
--  the requirement-to-rule mapping.
-- ===========================================================================

in exec:    Events[Int]
in ready:   Events[Int]
in blocked: Events[Int]

in delay_task:  Events[Int]    -- Non-Blocking Delay: start (task index)
-- Duration PER TASK as its own stream. There used to be one shared
-- delay_ticks stream, from which the duration had to be filtered out via
-- filter(ticks, delay_task == i). Once delays from several tasks
-- interleave, this attribution systematically breaks (the converter
-- nudges equal timestamps within a stream apart by +1ns, so the two
-- streams no longer line up exactly). Separate streams make the
-- attribution unambiguous.
in delay_ticks_0: Events[Int]
in delay_ticks_1: Events[Int]
in delay_ticks_2: Events[Int]
in delay_ticks_3: Events[Int]
in busy_task:   Events[Int]    -- Blocking/busy delay: start (task)
in busy_end:    Events[Int]    -- Blocking/busy delay: end (task)

-- Resource-block events of all kernel objects: needed to attribute a
-- wake-up to the delay (and not, say, to a semaphore).
in mtx_uart_block:     Events[Int]
in mtx_cfg_block:      Events[Int]
in sem_echo_block:     Events[Int]
in sem_uartrx_block:   Events[Int]
in q_sensor_send_block: Events[Int]
in q_sensor_recv_block: Events[Int]
in q_proc_send_block:   Events[Int]
in q_proc_recv_block:   Events[Int]

-- 1 scheduler tick = 80us (in ns), measured empirically from the trace
-- (the target's SysTick configuration, not the 1ms originally assumed).
def TICK: Int   = 80000
-- Fixed 250ms warm-up, deliberately NOT expressed as a multiple of TICK:
-- recording starts mid-flight, and the reconstructed state needs some
-- real time to converge regardless of how long a tick is.
def WARMUP: Int = 250000000
def TOL: Int    = 2 * TICK

def guard(v: Events[Bool]): Events[Bool] = filter(v, v && time(v) > WARMUP)

def rd(i: Int): Events[Int] = filter(ready,   ready   == i)
def bl(i: Int): Events[Int] = filter(blocked, blocked == i)
def state(i: Int): Events[Int] =
  merge(merge(const(1, filter(exec, exec == i)), const(0, rd(i))),
        const(2, bl(i)))

-- All resource blocks combined into one stream (for cause attribution)
def resBlock: Events[Int] =
  merge(merge(merge(mtx_uart_block, mtx_cfg_block),
              merge(sem_echo_block, sem_uartrx_block)),
        merge(merge(q_sensor_send_block, q_sensor_recv_block),
              merge(q_proc_send_block, q_proc_recv_block)))

-- ---------------------------------------------------------------------------
-- RULE: non-blocking delays move the task to BLOCKED
--  (obligation + exec heartbeat, as in mutex.tessla)
-- ---------------------------------------------------------------------------
def blockObl(i: Int): Events[Int] =
  merge(time(filter(delay_task, delay_task == i)), const(-1, bl(i)))
def blockLate(i: Int): Events[Bool] =
     default(blockObl(i), -1) >= 0
  && time(exec) - default(blockObl(i), -1) > TOL
def violation_delay_block_state = guard(merge(merge(
    blockLate(0), blockLate(1)), merge(blockLate(2), blockLate(3))))
out violation_delay_block_state

-- ---------------------------------------------------------------------------
-- RULE: blocking (busy) delays trigger NO state change
--  Between BusyDelayStart(i) and BusyDelayEnd(i), task i must not become
--  BLOCKED. (Preemption -> READY is still allowed - that's not caused by
--  the delay, it's caused by the tick.)
-- ---------------------------------------------------------------------------
def inBusy(i: Int): Events[Bool] =
  default(merge(const(true,  filter(busy_task, busy_task == i)),
                const(false, filter(busy_end,  busy_end  == i))), false)
def busyBad(i: Int): Events[Bool] = filter(const(true, bl(i)), inBusy(i))
def violation_busy_state_change = guard(merge(merge(
    busyBad(0), busyBad(1)), merge(busyBad(2), busyBad(3))))
out violation_busy_state_change

-- ---------------------------------------------------------------------------
-- Wake-up events: ready(i) with state BLOCKED immediately before it.
-- (The tick's RUNNING->READY relabeling is NOT a wake-up.)
-- Attribution to the delay: the most recent delay-start event for i is
-- more recent than the most recent resource block for i.
-- ---------------------------------------------------------------------------
def wake(i: Int): Events[Int] =
  filter(rd(i), default(last(state(i), rd(i)), 1) == 2)
def lastDelayT(i: Int): Events[Int] =
  time(filter(delay_task, delay_task == i))
def lastDelayTicks(i: Int): Events[Int] =
  if i == 0 then delay_ticks_0
  else if i == 1 then delay_ticks_1
  else if i == 2 then delay_ticks_2
  else delay_ticks_3
def lastResT(i: Int): Events[Int] =
  time(filter(resBlock, resBlock == i))
def delayWake(i: Int): Events[Int] =
  filter(wake(i),
         default(last(lastDelayT(i), wake(i)), -1)
         > default(last(lastResT(i), wake(i)), -2))

-- RULE: no wake-up before the delay time has elapsed
--  Only checked if a delay start has actually occurred for THIS task -
--  otherwise the fallback yields an artificial huge difference and
--  a false violation (same root cause as in semaphore.tessla).
def earlyWake(i: Int): Events[Bool] =
  filter(const(true, delayWake(i)),
         default(last(lastDelayT(i), delayWake(i)), -1) >= 0
         && time(delayWake(i))
              - default(last(lastDelayT(i), delayWake(i)), -1000000000)
            < default(last(lastDelayTicks(i), delayWake(i)), 0) * TICK - 2 * TICK)
def violation_delay_early_wake = guard(merge(merge(
    earlyWake(0), earlyWake(1)), merge(earlyWake(2), earlyWake(3))))
out violation_delay_early_wake

-- RULE: after the delay elapses, the task transitions to READY
--  Deadline obligation: delay start sets (start + ticks*TICK). It is
--  cleared by the next ACTUAL delay wake-up (delayWake), not by every
--  raw ready(i) - otherwise a ready caused by preemption or by a wake-up
--  from a different cause (mutex/semaphore/queue) could clear the
--  obligation early, or a stale deadline from a long-finished delay could
--  linger until some unrelated later ready(i) happens to trigger it.
def readyObl(i: Int): Events[Int] =
  merge(time(filter(delay_task, delay_task == i))
          + lastDelayTicks(i) * TICK,
        const(-1, delayWake(i)))
def readyLate(i: Int): Events[Bool] =
     default(readyObl(i), -1) >= 0
  && time(exec) - default(readyObl(i), -1) > 3 * TICK
def violation_delay_ready_after = guard(merge(merge(
    readyLate(0), readyLate(1)), merge(readyLate(2), readyLate(3))))
out violation_delay_ready_after
